generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  ANALYST
  VIEWER
}

enum ContactStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  SENT
  PAUSED
  CANCELLED
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

enum WorkflowTriggerType {
  CONTACT_SUBSCRIBED
  TAG_ADDED
}

enum WorkflowStepType {
  EMAIL
  DELAY
  CONDITION
}

enum WorkflowEnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  FAILED
  CANCELLED
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DnsRecordType {
  TXT
  CNAME
  MX
}

enum DnsRecordStatus {
  VERIFIED
  MISSING
  INVALID
  PENDING
}

enum DnsRecordPurpose {
  SPF
  DKIM
  DMARC
  TRACKING
}

enum DeliverabilityRiskLevel {
  LOW
  MEDIUM
  HIGH
}

// ==========================================
// USER MODEL
// ==========================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleSub    String?  @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())

  memberships WorkspaceMember[]
  campaigns   Campaign[]
  workflows   Workflow[]
}

// ==========================================
// LOGIN ATTEMPT MODEL (THROTTLING)
// ==========================================

model LoginAttempt {
  id          String    @id @default(cuid())
  key         String    @unique
  attempts    Int       @default(1)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// ==========================================
// WORKSPACE MODEL
// ==========================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members   WorkspaceMember[]
  contacts  Contact[]
  campaigns Campaign[]
  templates EmailTemplate[]
  workflows Workflow[]
  brandVoice BrandVoice?
  sendingDomains SendingDomain[]
  deliverabilityChecks DeliverabilityCheck[]
}

// ==========================================
// WORKSPACE MEMBER MODEL
// ==========================================

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(OWNER)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ==========================================
// CONTACT MODEL
// ==========================================

model Contact {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  firstName   String?
  lastName    String?
  company     String?
  status      ContactStatus @default(SUBSCRIBED)
  tags        String[]      @default([])
  source      String        @default("manual")
  consentAt   DateTime?
  unsubscribedAt DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignRecipients CampaignRecipient[]
  workflowEnrollments WorkflowEnrollment[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
}

// ==========================================
// EMAIL TEMPLATE MODEL
// ==========================================

model EmailTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  subject     String
  previewText String?
  content     Json
  html        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([workspaceId])
}

// ==========================================
// CAMPAIGN MODEL
// ==========================================

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  createdById String?
  templateId  String?

  name        String
  description String?
  subject     String
  previewText String?
  fromName    String?
  fromEmail   String?
  html        String

  // Audience targeting: filter contacts by tags and/or status
  targetTags   String[]  @default([])
  targetStatus String?

  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  completedAt DateTime?
  lockedAt    DateTime?

  // Sending progress counters
  sendTotal       Int @default(0)
  sendSucceeded   Int @default(0)
  sendFailed      Int @default(0)
  deliveredCount  Int @default(0)
  bouncedCount    Int @default(0)
  openedCount     Int @default(0)
  clickedCount    Int @default(0)
  complainedCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  template   EmailTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]
  deliverabilityChecks DeliverabilityCheck[]

  @@index([workspaceId, status])
  @@index([createdById])
}

// ==========================================
// CAMPAIGN RECIPIENT MODEL
// ==========================================

model CampaignRecipient {
  id         String          @id @default(cuid())
  campaignId String
  contactId  String
  email      String

  status     RecipientStatus @default(PENDING)
  messageId  String?
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  bouncedAt     DateTime?
  error         String?
  attempts      Int             @default(0)
  lastAttemptAt DateTime?
  uncertain     Boolean         @default(false)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([messageId])
}

// ==========================================
// DELIVERY EVENT MODEL (WEBHOOK AUDIT & DEDUPE)
// ==========================================

model DeliveryEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  messageId String?
  event     String
  email     String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([messageId])
}

// ==========================================
// WORKFLOW MODELS (AUTOMATION & DRIP SEQUENCES)
// ==========================================

model Workflow {
  id            String              @id @default(cuid())
  workspaceId   String
  createdById   String?
  name          String
  description   String?
  type          String              @default("DRIP")
  triggerType   WorkflowTriggerType @default(CONTACT_SUBSCRIBED)
  triggerConfig Json?               @default("{}")
  definition    Json?               @default("{}")
  active        Boolean             @default(false)
  startDate     DateTime?
  endDate       DateTime?
  lockedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  steps         WorkflowStep[]
  enrollments   WorkflowEnrollment[]

  @@index([workspaceId, active])
  @@index([createdById])
}

model WorkflowStep {
  id          String              @id @default(cuid())
  workflowId  String
  stepOrder   Int                 @default(0)
  type        WorkflowStepType    @default(EMAIL)
  name        String?
  config      Json                @default("{}")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workflow    Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions  WorkflowExecution[]

  @@unique([workflowId, stepOrder])
  @@index([workflowId])
}

model WorkflowEnrollment {
  id              String                   @id @default(cuid())
  workflowId      String
  contactId       String
  status          WorkflowEnrollmentStatus @default(ACTIVE)
  currentStepId   String?
  nextExecutionAt DateTime                 @default(now())
  enrolledAt      DateTime                 @default(now())
  completedAt     DateTime?
  lockedAt        DateTime?
  error           String?

  workflow        Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  contact         Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  executions      WorkflowExecution[]

  @@unique([workflowId, contactId])
  @@index([workflowId, status])
  @@index([contactId])
  @@index([status, nextExecutionAt])
}

model WorkflowExecution {
  id           String                  @id @default(cuid())
  enrollmentId String
  stepId       String
  status       WorkflowExecutionStatus @default(PENDING)
  executedAt   DateTime?
  error        String?
  retryCount   Int                     @default(0)
  metadata     Json?

  enrollment   WorkflowEnrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step         WorkflowStep            @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([stepId])
  @@index([status])
}

// ==========================================
// BRAND VOICE MODEL
// ==========================================

model BrandVoice {
  id                  String   @id @default(cuid())
  workspaceId         String   @unique
  brandName           String   @default("")
  businessDescription String?  @default("")
  industry            String?  @default("")
  targetAudience      String?  @default("")
  preferredTone       String?  @default("Professional")
  brandPersonality    String?  @default("")
  preferredVocabulary String[] @default([])
  prohibitedPhrases   String[] @default([])
  styleGuidelines     String?  @default("")
  defaultLanguage     String   @default("English")
  websiteUrl          String?  @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ==========================================
// DELIVERABILITY & SENDING DOMAIN MODELS
// ==========================================

model SendingDomain {
  id                   String          @id @default(cuid())
  workspaceId          String
  domain               String
  status               DomainStatus    @default(PENDING)
  spfStatus            DnsRecordStatus @default(PENDING)
  dkimStatus           DnsRecordStatus @default(PENDING)
  dmarcStatus          DnsRecordStatus @default(PENDING)
  customTrackingStatus DnsRecordStatus @default(PENDING)
  trackingSubdomain    String?         @default("track")
  dkimSelector         String          @default("mailo")
  healthScore          Int             @default(50)
  lastVerifiedAt       DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dnsRecords    DomainDnsRecord[]
  healthHistory DomainHealthHistory[]

  @@unique([workspaceId, domain])
  @@index([workspaceId])
  @@index([domain])
}

model DomainDnsRecord {
  id            String           @id @default(cuid())
  domainId      String
  recordType    DnsRecordType
  name          String
  expectedValue String
  actualValue   String?
  status        DnsRecordStatus  @default(PENDING)
  purpose       DnsRecordPurpose
  lastCheckedAt DateTime?
  errorMessage  String?

  domain SendingDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
}

model DeliverabilityCheck {
  id          String                  @id @default(cuid())
  workspaceId String
  campaignId  String?
  subject     String
  score       Int
  riskLevel   DeliverabilityRiskLevel @default(LOW)
  issues      Json                    @default("[]")
  suggestions Json                    @default("[]")
  createdAt   DateTime                @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([campaignId])
}

model DomainHealthHistory {
  id             String        @id @default(cuid())
  domainId       String
  healthScore    Int
  spfOk          Boolean       @default(false)
  dkimOk         Boolean       @default(false)
  dmarcOk        Boolean       @default(false)
  trackingOk     Boolean       @default(false)
  deliveryRate   Float?
  bounceRate     Float?
  complaintRate  Float?
  recordedAt     DateTime      @default(now())

  domain SendingDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@index([recordedAt])
}


