# PostgreSQL connection string (use a pooled URL for serverless runtime if your provider supplies one)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a long random secret. Never commit the real value.
JWT_SECRET="replace-with-at-least-32-random-characters"
CLIENT_URL="http://localhost:8888"

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# OpenAI API key; server-side only
OPENAI_API_KEY="sk-your-key"
OPENAI_MODEL="gpt-6-astra"

# Optional email provider (not required for local demo or AI generation)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="verified-sender@example.com"
BREVO_SENDER_NAME="MailFlow AI"
